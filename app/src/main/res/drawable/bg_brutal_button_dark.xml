<?xml version="1.0" encoding="utf-8"?>
<!-- Boxy dark button: surface fill, white stroke, hard offset shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="@dimen/brutal_shadow_offset"
        android:top="@dimen/brutal_shadow_offset">
        <shape android:shape="rectangle">
            <solid android:color="@color/brutal_shadow" />
        </shape>
    </item>
    <item
        android:right="@dimen/brutal_shadow_offset"
        android:bottom="@dimen/brutal_shadow_offset">
        <shape android:shape="rectangle">
            <solid android:color="@color/brutal_surface" />
            <stroke
                android:width="@dimen/brutal_stroke_width"
                android:color="@color/brutal_stroke" />
        </shape>
    </item>
</layer-list>
