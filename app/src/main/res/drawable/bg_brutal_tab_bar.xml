    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brutal_stroke" />
        </shape>
    </item>
    <item android:top="@dimen/brutal_stroke_width">
        <shape android:shape="rectangle">
            <solid android:color="@color/brutal_background" />
        </shape>
    </item>
</layer-list>
